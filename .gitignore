# ==============================================================================
# Collabex / Project Hub — Root Git Ignore
# ==============================================================================

# ------------------------------------------------------------------------------
# .NET / C#
# ------------------------------------------------------------------------------
bin/
obj/
*.user
*.userosscache
*.suo
*.userprefs
.vs/
*.dotCover

# Capstone Document Vault (binary files)
backend/src/ProjectHub.Api/App_Data/vault/*
!backend/src/ProjectHub.Api/App_Data/vault/.gitkeep

# Local developer overrides (allow safe appsettings.Development.json in repo)
appsettings.Local.json
*.local.json

# ------------------------------------------------------------------------------
# Next.js / Node
# ------------------------------------------------------------------------------
node_modules/
web/node_modules/
.next/
web/.next/
out/
web/out/
build/
dist/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.vercel

# ------------------------------------------------------------------------------
# Environment & Secrets (Local development defaults tracked for 1-click startup)
# ------------------------------------------------------------------------------
.env.*.local
web/.env.*.local
!.env
!web/.env
!web/.env.local
!web/.env.example
!.env.example

# ------------------------------------------------------------------------------
# Docker & Databases
# ------------------------------------------------------------------------------
postgres_data/
redis_data/

# ------------------------------------------------------------------------------
# OS / Editor
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
[Dd]esktop.ini
.idea/
.vscode/
*.swp
*.swo

# Project cleanup
/api
backend/src/ProjectHub.WebApi
