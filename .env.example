# ==============================================================================
# Project Hub — Environment Configuration Template
# Copy this file to .env before starting local infrastructure
# ==============================================================================

# Database (PostgreSQL 17)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=projecthub_db
POSTGRES_PORT=5432
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=projecthub_db;Username=postgres;Password=postgres;Include Error Detail=true

# Cache (Redis 7)
REDIS_PORT=6379
REDIS_CONNECTION_STRING=localhost:6379

# Backend API Configuration (.NET 10 LTS)
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000
JWT_SECRET=ProjectHubSuperSecretDevKeyMinLength32CharactersRequired!
JWT_ISSUER=https://api.projecthub.local
JWT_AUDIENCE=https://app.projecthub.local
JWT_EXPIRY_MINUTES=1440

# Frontend Web Application (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:5000
PORT=3000

# Transactional Email & Trusted Frontend Base URL (.NET Configuration Overrides)
# In Production, set Email__Provider=Smtp, HTTPS Frontend__BaseUrl, and valid SMTP credentials.
Email__Provider=Development
Email__SmtpHost=
Email__SmtpPort=587
Email__SmtpUser=
Email__SmtpPassword=
Email__FromAddress=
Email__FromName=Colabex Security
Email__EnableSsl=true
Email__TimeoutSeconds=15
Email__Worker__BatchSize=20
Email__Worker__MaxConcurrency=4
Email__Worker__PollIntervalSeconds=5
Email__Worker__LeaseSeconds=60
Email__Worker__MaxAttempts=5
Email__Worker__BaseRetryDelaySeconds=5
Email__Worker__MaxRetryDelaySeconds=300
DataProtection__KeysPath=
Frontend__BaseUrl=http://localhost:3000

